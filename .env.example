# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://ciqflsvaroxbrkjexjqx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret / service-role key — SERVER ONLY (src/lib/supabase/admin.ts)
