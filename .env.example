# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (public: safe in the browser). Production uses the publishable key (sb_publishable_…, D-109).
NEXT_PUBLIC_SUPABASE_URL=https://ciqflsvaroxbrkjexjqx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (sb_secret_…, D-109) — SERVER ONLY (src/lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used to build customer links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "on" enables "Forgot password?" emails. Leave unset in production until custom SMTP is configured:
# Supabase's built-in mailer only reaches the project team. Off → /forgot-password tells staff to ask the owner.
PASSWORD_RESET_EMAIL=

# Seed staff passwords — generated by `pnpm credentials:generate`, never committed
SEED_OWNER_PASSWORD=
SEED_MECHANIC_1_PASSWORD=
SEED_MECHANIC_2_PASSWORD=
SEED_MECHANIC_3_PASSWORD=
